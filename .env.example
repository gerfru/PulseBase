# Datenbank — Admin-User (Flyway-Migrationen)
DB_USER=garmin
DB_PASSWORD=changeme

# Datenbank — App-User (Least Privilege: nur SELECT/INSERT/UPDATE/DELETE)
DB_APP_USER=garmin_app
DB_APP_PASSWORD=changeme_app

# FastAPI Session-Secret (zufällig, min. 32 Zeichen) — generieren mit: make gen-secrets
SESSION_SECRET=

# HTTPS-only Cookies (false fuer lokale Entwicklung ohne TLS)
HTTPS_ONLY=true

# Hostname (in hosts-Datei eintragen, siehe: make setup)
HOST_IP=garmin.local

# Sync-Einstellungen
SYNC_HOUR=6
SYNC_LOOKBACK_DAYS=30   # initialer Backfill beim ersten Start
SYNC_DAILY_DAYS=2       # täglicher Sync + manueller Sync-Button

# ML-Service
ML_INFER_HOUR=7

# Training-Load Forecast (ATL-Kurve)
TRIMP_LOOKBACK_DAYS=7    # Tage in die Vergangenheit (historische Last anzeigen)
TRIMP_FORECAST_DAYS=7    # Tage in die Zukunft (ATL-Abklingkurve projizieren)

# Garmin-Passwörter werden NICHT gespeichert.
# Garmin-Accounts werden einmalig über die Web-App verknüpft (https://HOST_IP/garmin/link).
