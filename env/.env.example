# Datenbank — Admin-User (Flyway-Migrationen)
DB_USER=garmin
DB_PASSWORD=changeme

# Datenbank — App-User (Least Privilege: nur SELECT/INSERT/UPDATE/DELETE)
DB_APP_USER=garmin_app
DB_APP_PASSWORD=changeme_app

# Hostname / Domain (öffentlich: deine-domain.com, lokal: pulsebase.local + make add-host)
HOST_IP=your-domain.com

# Fernet Key für Token-Verschlüsselung (Garmin/LibreLink) — generieren mit: make gen-secrets
# python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=
