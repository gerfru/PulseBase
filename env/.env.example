# Datenbank — Admin-User (nur Flyway-Migrationen; wird NICHT in App-Containern injiziert)
# App-User-Credentials → env/.env.app
DB_USER=garmin
DB_PASSWORD=changeme

# Hostname / Domain (öffentlich: deine-domain.com, lokal: pulsebase.local + make add-host)
HOST_IP=your-domain.com

# Tailscale-IP des Mac mini (100.x.x.x) — für Monitoring-UIs erreichbar im VPN
# Ermitteln mit: tailscale ip -4
TAILSCALE_IP=100.x.x.x

# ACME / Let's Encrypt (nur standalone-Modus mit Traefik)
# E-Mail-Adresse für Let's Encrypt-Zertifikate (Ablauf-Benachrichtigungen)
ACME_EMAIL=your@email.com
