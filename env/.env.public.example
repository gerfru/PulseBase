# Öffentliche SaaS-Instanz — gelesen von docker-compose.public.yml (caddy + vector).
# Kopieren nach env/.env.public und ausfüllen (env/.env.public ist git-ignored).

# Öffentliche Domain (DNS-A-Record muss auf die VPS-IP zeigen, BEVOR `make up-public`)
PUBLIC_DOMAIN=app.example.com

# Kontakt-Mail für Let's Encrypt (ACME)
ACME_EMAIL=you@example.com

# Better Stack Logs — Source-Token (https://betterstack.com/logs). Für Axiom
# stattdessen AXIOM_TOKEN/AXIOM_DATASET setzen und den Sink in vector.public.toml tauschen.
BETTERSTACK_SOURCE_TOKEN=
