# Backup-Sidecar (Container-Scheduler) — kopieren nach env/.env.backup (git-ignored).
# Die DB-Zugangsdaten kommen aus env/.env (Admin-Rolle); hier NICHT duplizieren.

# age-Recipient (PUBLIC key) — verschlüsselt jedes Backup. Erzeugen auf einer
# VERTRAUENSWÜRDIGEN Offsite-Maschine (nicht auf dem Server):
#   age-keygen -o pulsebase-backup.key
# Den "Public key: age1…"-Wert hierher; die Key-Datei NUR offsite/Passwortmanager.
AGE_RECIPIENT=

# Zeitpunkt des täglichen Backups (UTC), vom Scheduler-Loop ausgewertet.
BACKUP_HOUR=3
BACKUP_MINUTE=30

# Aufbewahrung lokaler Backups in Tagen (ältere werden gelöscht).
BACKUP_RETENTION_DAYS=14

# Optional: Offsite-Kopie via rclone (3-2-1-Regel). Leer = aus.
# Das Remote muss in der rclone-Config existieren, z. B. b2:pulsebase-backups
RCLONE_REMOTE=

# --- Nur für `make restore-test` / manuelles Restore -------------------------
# Pfad (auf dem Host) zum age-PRIVATE-Key. `make restore-test` liest ihn aus dieser
# Zeile und mountet die Datei read-only in den Container. NIEMALS committen.
# Leer lassen, solange du keinen Restore-Test fährst.
AGE_IDENTITY=
