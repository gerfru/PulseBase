# Sync-Einstellungen
SYNC_INTERVAL_HOURS=2   # Garmin-Polling-Intervall (alle X Stunden)
SYNC_LOOKBACK_DAYS=30   # initialer Backfill beim ersten Start
SYNC_DAILY_DAYS=2       # Tage pro Interval-Run
SYNC_EVENT_CONSUMER_ENABLED=true
SYNC_EVENT_SWEEP_SECONDS=30

# Sentry DSN wird zentral in env/.env.app gesetzt (gilt für alle 3 Services).
