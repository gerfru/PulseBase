# Datenbank — Per-Service-Rollen (Least Privilege, V24).
# garmin_app = api (breit). sync/ml haben eng-granierte eigene Rollen.
# Diese 6 Werte speisen sowohl die Flyway-Platzhalter (Rollen-Anlage) als auch
# die Service-Container (sync liest DB_SYNC_*, ml liest DB_ML_*, api liest DB_APP_*).
DB_APP_USER=garmin_app
DB_APP_PASSWORD=changeme_app
DB_SYNC_USER=pulse_sync
DB_SYNC_PASSWORD=changeme_sync
DB_ML_USER=pulse_ml
DB_ML_PASSWORD=changeme_ml

# Fernet Key für Token-Verschlüsselung (Garmin/LibreLink) — generieren mit: make gen-secrets
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Sentry DSN für Error Tracking (alle 3 Services: api, sync, ml)
# https://sentry.io → Projekt → Settings → Client Keys
SENTRY_DSN=
