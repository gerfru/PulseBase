# FastAPI Session-Secret (zufällig, min. 32 Zeichen) — generieren mit: make gen-secrets
SESSION_SECRET=

# HTTPS-only Cookies (false fuer lokale Entwicklung ohne TLS)
HTTPS_ONLY=true

# Training-Load Forecast (ATL-Kurve)
# TRIMP_LOOKBACK_DAYS: Tage in die Vergangenheit (historische Last anzeigen)
# TRIMP_FORECAST_DAYS: Tage in die Zukunft (ATL-Abklingkurve projizieren)
TRIMP_LOOKBACK_DAYS=7
TRIMP_FORECAST_DAYS=7

# Password-Reset via Resend (https://resend.com — kostenlos bis 3.000 Mails/Mo)
# RESEND_API_KEY: re_... von resend.com; leer lassen = Reset-Link nur im Log
# RESEND_FROM_EMAIL: eigene Domain nach Verifizierung in Resend eintragen
# APP_BASE_URL: Basis-URL fuer Reset-Links in Mails
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
APP_BASE_URL=https://your-domain.com

# Datenschutzversion — bump wenn sich der Inhalt von /privacy wesentlich aendert.
# Aenderung erzwingt neues Consent-Log (user_consents Tabelle) fuer alle Folge-Registrierungen.
PRIVACY_POLICY_VERSION=v1.0

# Trusted Proxy CIDRs fuer IP-basiertes Rate Limiting (X-Forwarded-For)
# Docker-Bridge-Netzwerk CIDR + localhost; CIDR aus `docker network inspect <netzwerk>` ermitteln
TRUSTED_PROXY_CIDRS=["172.16.0.0/12","127.0.0.1/32"]

# Sentry DSN wird zentral in env/.env.app gesetzt (gilt für alle 3 Services).

# asyncpg Connection-Pool-Sizing (Defaults entsprechen den bisherigen Hardcodes)
# Hochsetzen bei mehreren uvicorn-Workern / hoher Last
DB_POOL_MIN=1
DB_POOL_MAX=5

# KI-Wochen-Insights (ADR-0003) — lokales LLM via Ollama.
# OLLAMA_ENABLED: false = keine Generierung, deterministisches Fallback wird genutzt.
# OLLAMA_BASE_URL: Ollama laeuft NATIV am Host (nicht in Docker, wegen Metal-GPU).
#   Mac (Docker Desktop): host.docker.internal funktioniert ootb.
#   Linux: api-Service braucht `extra_hosts: ["host.docker.internal:host-gateway"]`.
# OLLAMA_MODEL: ein am Host gezogenes Modell (`ollama pull <model>`).
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=30
